# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in the values.
# THIS is where you put your API key for testing.
# ---------------------------------------------------------------------------

# Required for the voiceover (your ElevenLabs cloned voice), which is the default.
# Get it at: https://elevenlabs.io/app/settings/api-keys
ELEVEN_API_KEY=

# Your cloned voice's id. Fill this in once, after you've created the clone in
# ElevenLabs Voice Lab (https://elevenlabs.io/app/voice-lab).
# Find it with:  python elevenlabs_voice.py --check
# When set, every voiceover uses YOUR voice by default.
ELEVEN_VOICE_ID=

# ---- Optional ----

# Show a dollar estimate after each voiceover. Set to your plan's price per 1,000
# characters (leave blank/0 to just show characters used). Example: 0.30
ELEVEN_USD_PER_1K_CHARS=

# Override the TTS model (default eleven_multilingual_v2).
# ELEVEN_MODEL_ID=eleven_multilingual_v2

# ---------------------------------------------------------------------------
# Grok / xAI generation (used by generate_shots.py / build_reel.py, see
# imageGenSkill.MD for the full write-up).
# Get it at: https://console.x.ai (API Keys)
# ---------------------------------------------------------------------------
XAI_API_KEY=

# Override the default models (grok-imagine-image / grok-imagine-video).
# Note: 1080p video requires grok-imagine-video-1.5 — the base model rejects
# it. Carving shots.json files set this per-job instead.
# XAI_IMAGE_MODEL=grok-imagine-image
# XAI_VIDEO_MODEL=grok-imagine-video-1.5

# ---------------------------------------------------------------------------
# Google Gemini / Veo (veo_carve.py, make_ladder.py default --engine gemini).
# Get it at: https://aistudio.google.com (API keys). Veo is prepay-billed —
# top up at https://ai.studio/projects or generation 429s with
# "prepayment credits are depleted". Needs: pip install "google-genai>=2.0"
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Google Earth Engine (golfFlyoverSkill.MD / golfCompliationskill.MD's
# GPS+satellite fallback for hole maps). One-time setup:
#   1. Register a Cloud project for Earth Engine at
#      https://code.earthengine.google.com (or reuse an existing one).
#   2. Authenticate this machine once: run
#      earthengine authenticate
#      (installed at %APPDATA%\Python\Python312\Scripts\earthengine.exe if
#      not on PATH).
# ---------------------------------------------------------------------------
EARTHENGINE_PROJECT=

# ---------------------------------------------------------------------------
# Kling AI (video generation backend for carvegen / carve.py).
# Get your API key at https://kling.ai/dev . See CARVEGEN.md.
# ---------------------------------------------------------------------------
KLING_API_KEY=
# Legacy access/secret pair (only if you have no single API key):
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Global/Singapore default: https://api-singapore.klingai.com
# Mainland:                 https://api.klingai.com
# KLING_API_BASE=https://api-singapore.klingai.com
